# Try to set system locale for better encoding support
try:
    locale.setlocale(locale.LC_ALL, '')
except:
    pass
    
# Ensure stdout can handle UTF-8
if sys.stdout.encoding != 'utf-8':
    try:
        # For Windows, try to set console to utf-8 mode
        if os.name == 'nt':
            os.system('chcp 65001')
    except:
        # If that fails, we'll use ASCII replacement characters
        pass

class CryptoTracker:
    def __init__(self):
        self.api_url = "https://api.coingecko.com/api/v3"
        self.update_interval = 60  # Default refresh seconds
        self.watchlist = []  # User's cryptocurrency watchlist
        self.alerts = {}  # Price alerts
        self.portfolio = {}  # User's portfolio holdings
        self.config_dir = Path.home() / ".config" / "cyrethium-coinwatch"
        self.config_file = self.config_dir / "config.json"
        self.fiat_currency = "usd"  # Default currency
        self.use_proxy = False  # Privacy feature for Tor/proxy
        self.proxy_url = "socks5://127.0.0.1:9050"  # Default Tor proxy
        self.alert_thread = None
        self.alert_running = False
        
        # Create config directory
        self.config_dir.mkdir(parents=True, exist_ok=True)
        
        # Load configuration
        self.load_config()
        
        # Setup session with proxy if enabled
        self.session = requests.Session()
        if self.use_proxy:
            self.setup_proxy()
        
    def setup_proxy(self):
        """Setup proxy for privacy (Tor support)"""
        try:
            proxies = {
                'http': self.proxy_url,
                'https': self.proxy_url
            }
            self.session.proxies.update(proxies)
            print(f"{Fore.GREEN}Proxy enabled: {self.proxy_url}{Style.RESET_ALL}")
        except Exception as e:
            print(f"{Fore.RED}Proxy setup failed: {e}{Style.RESET_ALL}")
            self.use_proxy = False
    
    def load_config(self):
        """Load configuration from file"""
        try:
            if self.config_file.exists():
                with open(self.config_file, 'r') as f:
                    config = json.load(f)
                    self.watchlist = config.get('watchlist', [])
                    self.alerts = config.get('alerts', {})
                    self.portfolio = config.get('portfolio', {})
                    self.update_interval = config.get('update_interval', 60)
                    self.fiat_currency = config.get('fiat_currency', 'usd')
                    self.use_proxy = config.get('use_proxy', False)
                    self.proxy_url = config.get('proxy_url', 'socks5://127.0.0.1:9050')
        except Exception as e:
            print(f"{Fore.YELLOW}Config load error: {e}{Style.RESET_ALL}")
    
    def save_config(self):
        """Save configuration to file"""
        try:
            config = {
                'watchlist': self.watchlist,
                'alerts': self.alerts,
                'portfolio': self.portfolio,
                'update_interval': self.update_interval,
                'fiat_currency': self.fiat_currency,
                'use_proxy': self.use_proxy,
                'proxy_url': self.proxy_url
            }
            with open(self.config_file, 'w') as f:
                json.dump(config, f, indent=2)
        except Exception as e:
            print(f"{Fore.RED}Config save error: {e}{Style.RESET_ALL}")
    
    def clear_screen(self):
        """Clear terminal screen"""
        os.system('cls' if os.name == 'nt' else 'clear')
        
