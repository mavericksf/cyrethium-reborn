# ============================================================================
# MODULE 1: CYRETHIUM ANTI-FLOOD
# ============================================================================

class FloodAnalyzer:
    def __init__(self):
        self.traffic_history = {}
        self.suspicious_activity = []
        self.flood_thresholds = {
            'connections_per_second': 100,  # More than 100 connections per second
            'packets_per_second': 1000,    # More than 1000 packets per second
            'bytes_per_second': 10485760,  # More than 10MB per second
            'syn_flood_threshold': 50,     # More than 50 SYN-RECV sockets
            'udp_flood_threshold': 200,    # More than 200 UDP packets per second
            'icmp_flood_threshold': 100    # More than 100 ICMP packets per second
        }
        self.whitelisted_ips = set(['127.0.0.1', '::1'])
        self.baseline_established = False
        self.baseline_stats = {}

        # Tor/Cyrethonion awareness
        self.tor_ports = {9040, 9053, 9050, 9051}
        self.tor_virtual_net = ipaddress.ip_network('10.192.0.0/10')
        try:
            self.tor_uid_name = 'debian-tor'
            self.tor_uid = pwd.getpwnam(self.tor_uid_name).pw_uid
        except Exception:
            self.tor_uid = None

        self.tor_aware = self.detect_cyrethonion()
        if self.tor_aware:
            print(f"{Fore.YELLOW}Tor-aware mode enabled: ignoring Tor proxy traffic and ports (9040/9053/9050/9051) and VirtualAddrNetwork 10.192.0.0/10{Style.RESET_ALL}")
        
    def clear_screen(self):
        os.system('clear' if os.name == 'posix' else 'cls')
        
    def print_banner(self):
        banner = f"""{Fore.CYAN}
 _   _      _   ____            ____                              
| \ | | ___| |_/ ___|  ___  ___|  _ \ _ __ __ _  __ _  ___  _ __  
|  \| |/ _ \ __\___ \ / _ \/ __| | | | '__/ _` |/ _` |/ _ \| '_ \ 
| |\  |  __/ |_ ___) |  __/ (__| |_| | | | (_| | (_| | (_) | | | |
|_| \_|\___|\__|____/ \___|\___|____/|_|  \__,_|\__, |\___/|_| |_|
                                                |___/             
__________________________________________________________________
       
  NetSecDragon Network Security Tools | Developed by root0emir
__________________________________________________________________

                   {Fore.RED}NetSecDragon ANTI-FLOOD{Fore.CYAN}
             DoS & Flood Attack Detection{Style.RESET_ALL}
"""
        print(banner)
        
    def get_network_statistics(self):
        """Get detailed network statistics"""
        stats = {
            'timestamp': dt.now().isoformat(),
            'interfaces': {},
            'connections': {},
            'system': {}
        }
        
        try:
            # Get interface statistics
            net_io = psutil.net_io_counters(pernic=True)
            for interface, io_stats in net_io.items():
                stats['interfaces'][interface] = {
                    'bytes_sent': io_stats.bytes_sent,
                    'bytes_recv': io_stats.bytes_recv,
                    'packets_sent': io_stats.packets_sent,
                    'packets_recv': io_stats.packets_recv,
                    'errin': io_stats.errin,
                    'errout': io_stats.errout,
                    'dropin': io_stats.dropin,
                    'dropout': io_stats.dropout
                }
            
            # Get connection statistics
            connections = psutil.net_connections()
            conn_stats = defaultdict(int)
            ip_connections = defaultdict(int)
            
            for conn in connections:
                # Ignore Tor daemon/proxy connections when Tor-aware
                if self.tor_aware and self.is_tor_connection(conn):
                    continue
                if conn.raddr:
                    remote_ip = conn.raddr.ip
                    # Skip Tor virtual network addresses when Tor-aware
                    if self.tor_aware:
                        try:
                            if ipaddress.ip_address(remote_ip) in self.tor_virtual_net:
                                continue
                        except ValueError:
                            pass
                    if remote_ip not in self.whitelisted_ips:
                        ip_connections[remote_ip] += 1
                        conn_stats[f"{conn.status}_{conn.type}"] += 1
                        
            stats['connections'] = dict(conn_stats)
            stats['ip_connections'] = dict(ip_connections)
            
            # Get system load
            stats['system'] = {
                'cpu_percent': psutil.cpu_percent(),
                'memory_percent': psutil.virtual_memory().percent,
                'load_average': os.getloadavg() if hasattr(os, 'getloadavg') else [0, 0, 0]
            }
            
        except Exception as e:
            print(f"{Fore.RED}Error getting network statistics: {e}{Style.RESET_ALL}")
            
        return stats
        
    def get_packet_statistics(self):
        """Get packet-level statistics using netstat/ss"""
        packet_stats = {
            'tcp_stats': {},
            'udp_stats': {},
            'icmp_stats': {}
        }
        
        try:
            if os.name == 'posix':
                # Get TCP statistics
                result = subprocess.run(['cat', '/proc/net/snmp'], capture_output=True, text=True, timeout=5)
                if result.returncode == 0:
                    packet_stats.update(self.parse_snmp_stats(result.stdout))
                    
                # Get detailed connection states
                result = subprocess.run(['ss', '-s'], capture_output=True, text=True, timeout=5)
                if result.returncode == 0:
                    packet_stats.update(self.parse_ss_summary(result.stdout))

                # Count half-open connections (SYN-RECV) accurately
                result = subprocess.run(['ss', '-tan', 'state', 'syn-recv'], capture_output=True, text=True, timeout=5)
                if result.returncode == 0:
                    syn_recv_count = 0
                    for line in result.stdout.splitlines():
                        line = line.strip()
                        if not line or line.startswith('State'):
                            continue
                        if line.startswith('SYN-RECV'):
                            tokens = line.split()
                            lport = None
                            if len(tokens) >= 5:
                                local = tokens[3]
                                try:
                                    lport = int(local.rsplit(':', 1)[1])
                                except Exception:
                                    lport = None
                            # Ignore Tor proxy endpoints when Tor-aware
                            if self.tor_aware and lport in self.tor_ports:
                                continue
                            syn_recv_count += 1
                    packet_stats['tcp_syn_recv'] = syn_recv_count
                    
        except Exception as e:
            print(f"{Fore.YELLOW}Warning: Could not get packet statistics: {e}{Style.RESET_ALL}")
            
        return packet_stats
        
    def parse_snmp_stats(self, snmp_output):
        """Parse /proc/net/snmp for detailed protocol statistics"""
        stats = {}
        lines = snmp_output.strip().split('\n')
        
        for i in range(0, len(lines), 2):
            if i + 1 < len(lines):
                header = lines[i].split()
                values = lines[i + 1].split()
                
                if header[0].endswith(':'):
                    protocol = header[0][:-1].lower()
                    if len(header) == len(values):
                        protocol_stats = {}
                        for j in range(1, len(header)):
                            try:
                                protocol_stats[header[j]] = int(values[j])
                            except ValueError:
                                protocol_stats[header[j]] = values[j]
                        stats[protocol] = protocol_stats
                        
        return stats
        
    def parse_ss_summary(self, ss_output):
        """Parse ss -s summary output"""
        stats = {}
        
        for line in ss_output.split('\n'):
            line = line.strip()
            if 'TCP:' in line:
                # Parse TCP connection counts
                tcp_match = re.search(r'(\d+) established', line)
                if tcp_match:
                    stats['tcp_established'] = int(tcp_match.group(1))
                    
            elif 'UDP:' in line:
                # Parse UDP socket counts
                udp_match = re.search(r'(\d+) (?:sockets|ports)', line)
                if udp_match:
                    stats['udp_sockets'] = int(udp_match.group(1))
                    
        return stats
        
    def detect_cyrethonion(self):
        """Detect if Cyrethonion/Tor transparent proxying is active"""
        if os.name != 'posix':
            return False
        try:
            # Presence of Cyrethonion status file
            if os.path.exists('/var/lib/cyrethonion/started'):
                return True
            # Fallback: look for iptables REDIRECT to Tor TransPort (9040)
            res = subprocess.run(['iptables-save'], capture_output=True, text=True, timeout=3)
            if res.returncode == 0 and re.search(r'REDIRECT.*(to-ports|redir-port)[ =:]?9040', res.stdout):
                return True
        except Exception:
            pass
        return False

    def is_tor_connection(self, conn):
        """Return True if the connection belongs to Tor or to Tor proxy endpoints"""
        try:
            # Check owning process UID/name
            if conn.pid:
                try:
                    p = psutil.Process(conn.pid)
                    if self.tor_uid is not None:
                        try:
                            uids = p.uids()
                            if uids.effective == self.tor_uid or uids.real == self.tor_uid:
                                return True
                        except Exception:
                            pass
                    try:
                        if 'tor' in (p.name() or '').lower():
                            return True
                    except Exception:
                        pass
                except psutil.Error:
                    pass

            # Check local/remote endpoints for Tor proxy/control/DNS ports
            if conn.laddr:
                try:
                    lip = getattr(conn.laddr, 'ip', None)
                    lport = getattr(conn.laddr, 'port', None)
                    if lip in ('127.0.0.1', '::1') and lport in self.tor_ports:
                        return True
                except Exception:
                    pass
            if conn.raddr:
                try:
                    rip = getattr(conn.raddr, 'ip', None)
                    rport = getattr(conn.raddr, 'port', None)
                    if rip in ('127.0.0.1', '::1') and rport in self.tor_ports:
                        return True
                    # Skip Tor virtual network 10.192.0.0/10
                    if rip:
                        try:
                            if ipaddress.ip_address(rip) in self.tor_virtual_net:
                                return True
                        except ValueError:
                            pass
                except Exception:
                    pass
        except Exception:
            return False
        return False

    def calculate_traffic_rates(self, current_stats, previous_stats):
        """Calculate traffic rates between two measurements"""
        if not previous_stats:
            return {}
            
        rates = {}
        time_diff = (dt.fromisoformat(current_stats['timestamp']) - 
                    dt.fromisoformat(previous_stats['timestamp'])).total_seconds()
        
        if time_diff <= 0:
            return {}
            
        # Calculate interface rates
        rates['interfaces'] = {}
        for interface in current_stats['interfaces']:
            if interface in previous_stats['interfaces']:
                curr = current_stats['interfaces'][interface]
                prev = previous_stats['interfaces'][interface]
                
                rates['interfaces'][interface] = {
                    'bytes_sent_rate': (curr['bytes_sent'] - prev['bytes_sent']) / time_diff,
                    'bytes_recv_rate': (curr['bytes_recv'] - prev['bytes_recv']) / time_diff,
                    'packets_sent_rate': (curr['packets_sent'] - prev['packets_sent']) / time_diff,
                    'packets_recv_rate': (curr['packets_recv'] - prev['packets_recv']) / time_diff
                }
                
        return rates
        
    def analyze_flood_patterns(self, current_stats, rates):
        """Analyze network statistics for flood attack patterns"""
        suspicious = []
        current_time = dt.now()
        
        # Analyze connection floods
        if 'ip_connections' in current_stats:
            for ip, conn_count in current_stats['ip_connections'].items():
                if conn_count > self.flood_thresholds['connections_per_second']:
                    suspicious.append({
                        'type': 'CONNECTION_FLOOD',
                        'severity': 'HIGH',
                        'details': f"IP {ip} has {conn_count} simultaneous connections",
                        'source_ip': ip,
                        'connection_count': conn_count,
                        'timestamp': current_time.isoformat()
                    })
        
        # Analyze traffic rates for floods
        if rates and 'interfaces' in rates:
            for interface, interface_rates in rates['interfaces'].items():
                # Check for high packet rates (potential packet flood)
                total_packets_rate = interface_rates['packets_recv_rate']
                if total_packets_rate > self.flood_thresholds['packets_per_second']:
                    suspicious.append({
                        'type': 'PACKET_FLOOD',
                        'severity': 'HIGH',
                        'details': f"Interface {interface}: {total_packets_rate:.1f} packets/sec (threshold: {self.flood_thresholds['packets_per_second']})",
                        'interface': interface,
                        'packet_rate': total_packets_rate,
                        'timestamp': current_time.isoformat()
                    })
                
                # Check for high bandwidth usage (potential bandwidth flood)
                total_bytes_rate = interface_rates['bytes_recv_rate']
                if total_bytes_rate > self.flood_thresholds['bytes_per_second']:
                    suspicious.append({
                        'type': 'BANDWIDTH_FLOOD',
                        'severity': 'HIGH',
                        'details': f"Interface {interface}: {total_bytes_rate/1048576:.1f} MB/sec (threshold: {self.flood_thresholds['bytes_per_second']/1048576:.1f} MB/sec)",
                        'interface': interface,
                        'bandwidth_rate': total_bytes_rate,
                        'timestamp': current_time.isoformat()
                    })
        
        # Analyze system load impact
        if 'system' in current_stats:
            system = current_stats['system']
            if system['cpu_percent'] > 90:
                suspicious.append({
                    'type': 'HIGH_CPU_LOAD',
                    'severity': 'MEDIUM',
                    'details': f"High CPU usage: {system['cpu_percent']:.1f}% (possible flood impact)",
                    'cpu_percent': system['cpu_percent'],
                    'timestamp': current_time.isoformat()
                })
                
            if system['memory_percent'] > 90:
                suspicious.append({
                    'type': 'HIGH_MEMORY_USAGE',
                    'severity': 'MEDIUM',
                    'details': f"High memory usage: {system['memory_percent']:.1f}% (possible flood impact)",
                    'memory_percent': system['memory_percent'],
                    'timestamp': current_time.isoformat()
                })
        
        return suspicious
        
    def detect_syn_flood(self, packet_stats):
        """Detect SYN flood attacks using SYN-RECV backlog instead of total TCP segments"""
        suspicious = []
        
        syn_recv = packet_stats.get('tcp_syn_recv', 0)
        if syn_recv > self.flood_thresholds['syn_flood_threshold']:
            suspicious.append({
                'type': 'SYN_FLOOD',
                'severity': 'HIGH',
                'details': f"High number of half-open connections (SYN-RECV): {syn_recv} (threshold: {self.flood_thresholds['syn_flood_threshold']})",
                'syn_recv': syn_recv,
                'timestamp': dt.now().isoformat()
            })
        
        return suspicious
        
    def display_network_stats(self, stats, rates=None):
        """Display current network statistics"""
        print(f"\n{Fore.GREEN}Network Statistics:{Style.RESET_ALL}")
        print("-" * 80)
        
        # Display interface statistics
        if 'interfaces' in stats:
            print(f"\n{Fore.CYAN}Interface Statistics:{Style.RESET_ALL}")
            for interface, if_stats in stats['interfaces'].items():
                print(f"{Fore.YELLOW}{interface}:{Style.RESET_ALL}")
                print(f"  Bytes: {if_stats['bytes_recv']:,} in, {if_stats['bytes_sent']:,} out")
                print(f"  Packets: {if_stats['packets_recv']:,} in, {if_stats['packets_sent']:,} out")
                print(f"  Errors: {if_stats['errin']} in, {if_stats['errout']} out")
                print(f"  Drops: {if_stats['dropin']} in, {if_stats['dropout']} out")
                
                if rates and 'interfaces' in rates and interface in rates['interfaces']:
                    if_rates = rates['interfaces'][interface]
                    print(f"  {Fore.GREEN}Rates:{Style.RESET_ALL}")
                    print(f"    {if_rates['bytes_recv_rate']/1024:.1f} KB/s in, {if_rates['bytes_sent_rate']/1024:.1f} KB/s out")
                    print(f"    {if_rates['packets_recv_rate']:.1f} pkt/s in, {if_rates['packets_sent_rate']:.1f} pkt/s out")
                print()
        
        # Display connection statistics
        if 'connections' in stats and stats['connections']:
            print(f"{Fore.CYAN}Connection Statistics:{Style.RESET_ALL}")
            for conn_type, count in sorted(stats['connections'].items()):
                print(f"  {conn_type}: {count}")
        
        # Display top connecting IPs
        if 'ip_connections' in stats and stats['ip_connections']:
            print(f"\n{Fore.CYAN}Top Connecting IPs:{Style.RESET_ALL}")
            sorted_ips = sorted(stats['ip_connections'].items(), key=lambda x: x[1], reverse=True)
            for ip, count in sorted_ips[:10]:  # Show top 10
                color = Fore.RED if count > 50 else Fore.YELLOW if count > 20 else Fore.WHITE
                print(f"  {color}{ip}: {count} connections{Style.RESET_ALL}")
        
        # Display system statistics
        if 'system' in stats:
            system = stats['system']
            print(f"\n{Fore.CYAN}System Load:{Style.RESET_ALL}")
            cpu_color = Fore.RED if system['cpu_percent'] > 80 else Fore.YELLOW if system['cpu_percent'] > 60 else Fore.GREEN
            mem_color = Fore.RED if system['memory_percent'] > 80 else Fore.YELLOW if system['memory_percent'] > 60 else Fore.GREEN
            print(f"  CPU: {cpu_color}{system['cpu_percent']:.1f}%{Style.RESET_ALL}")
            print(f"  Memory: {mem_color}{system['memory_percent']:.1f}%{Style.RESET_ALL}")
            if system['load_average'][0] > 0:
                print(f"  Load Average: {system['load_average'][0]:.2f}, {system['load_average'][1]:.2f}, {system['load_average'][2]:.2f}")
                
    def display_suspicious_activity(self):
        """Display detected suspicious activity"""
        if not self.suspicious_activity:
            print(f"\n{Fore.GREEN}✓ No suspicious flood activity detected{Style.RESET_ALL}")
            return
            
        print(f"\n{Fore.RED}⚠ SUSPICIOUS FLOOD ACTIVITY DETECTED:{Style.RESET_ALL}")
        print("-" * 80)
        
        for activity in self.suspicious_activity[-10:]:  # Show last 10
            severity_color = Fore.RED if activity['severity'] == 'HIGH' else Fore.YELLOW
            print(f"{severity_color}[{activity['severity']}] {activity['type']}: {activity['details']}{Style.RESET_ALL}")
            if 'source_ip' in activity:
                print(f"  Source IP: {activity['source_ip']}")
            if 'interface' in activity:
                print(f"  Interface: {activity['interface']}")
            print(f"  Timestamp: {activity['timestamp']}")
            print()
            
    def continuous_monitoring(self, interval=5):
        """Start continuous monitoring"""
        print(f"\n{Fore.GREEN}Starting continuous flood monitoring (interval: {interval}s)...{Style.RESET_ALL}")
        print(f"{Fore.YELLOW}Press Ctrl+C to stop{Style.RESET_ALL}\n")
        
        previous_stats = None
        
        try:
            scan_count = 0
            while True:
                scan_count += 1
                print(f"\n{Fore.CYAN}--- Scan #{scan_count} at {dt.now().strftime('%H:%M:%S')} ---{Style.RESET_ALL}")
                
                current_stats = self.get_network_statistics()
                packet_stats = self.get_packet_statistics()
                
                rates = self.calculate_traffic_rates(current_stats, previous_stats)
                
                suspicious = self.analyze_flood_patterns(current_stats, rates)
                syn_floods = self.detect_syn_flood(packet_stats)
                suspicious.extend(syn_floods)
                
                self.suspicious_activity.extend(suspicious)
                
                if suspicious:
                    print(f"{Fore.RED}! {len(suspicious)} suspicious flood activities detected!{Style.RESET_ALL}")
                    for activity in suspicious:
                        print(f"  {activity['type']}: {activity['details']}")
                else:
                    print(f"{Fore.GREEN}✓ No suspicious flood activity in this scan{Style.RESET_ALL}")
                
                # Show brief stats
                if rates and 'interfaces' in rates:
                    total_pkt_rate = sum(if_rates.get('packets_recv_rate', 0) for if_rates in rates['interfaces'].values())
                    total_bw_rate = sum(if_rates.get('bytes_recv_rate', 0) for if_rates in rates['interfaces'].values())
                    print(f"  Total traffic: {total_pkt_rate:.1f} pkt/s, {total_bw_rate/1024:.1f} KB/s")
                
                previous_stats = current_stats
                time.sleep(interval)
                
        except KeyboardInterrupt:
            print(f"\n{Fore.YELLOW}Monitoring stopped by user{Style.RESET_ALL}")
            
    def save_report(self, filename=None):
        """Save analysis report to file"""
        if not filename:
            filename = f"antiflood_report_{dt.now().strftime('%Y%m%d_%H%M%S')}.json"
            
        report = {
            'timestamp': dt.now().isoformat(),
            'suspicious_activity': self.suspicious_activity,
            'flood_thresholds': self.flood_thresholds,
            'baseline_stats': self.baseline_stats
        }
        
        try:
            with open(filename, 'w') as f:
                json.dump(report, f, indent=2)
            print(f"{Fore.GREEN}Report saved to: {filename}{Style.RESET_ALL}")
        except Exception as e:
            print(f"{Fore.RED}Error saving report: {e}{Style.RESET_ALL}")
            
    def configure_thresholds(self):
        """Configure detection thresholds"""
        print(f"\n{Fore.CYAN}Current Flood Detection Thresholds:{Style.RESET_ALL}")
        for key, value in self.flood_thresholds.items():
            print(f"{key}: {value}")
        
        try:
            print(f"\n{Fore.YELLOW}Enter new values (press Enter to keep current):{Style.RESET_ALL}")
            
            new_conn = input(f"Connections per second (current: {self.flood_thresholds['connections_per_second']}): ")
            if new_conn:
                self.flood_thresholds['connections_per_second'] = int(new_conn)
                
            new_pkt = input(f"Packets per second (current: {self.flood_thresholds['packets_per_second']}): ")
            if new_pkt:
                self.flood_thresholds['packets_per_second'] = int(new_pkt)
                
            new_bw = input(f"Bytes per second (current: {self.flood_thresholds['bytes_per_second']}): ")
            if new_bw:
                self.flood_thresholds['bytes_per_second'] = int(new_bw)
                
            new_syn = input(f"SYN flood threshold (current: {self.flood_thresholds['syn_flood_threshold']}): ")
            if new_syn:
                self.flood_thresholds['syn_flood_threshold'] = int(new_syn)
                
            print(f"{Fore.GREEN}Thresholds updated successfully{Style.RESET_ALL}")
        except ValueError:
            print(f"{Fore.RED}Invalid input. Thresholds not changed.{Style.RESET_ALL}")
            
    def establish_baseline(self):
        """Establish baseline network statistics"""
        print(f"{Fore.YELLOW}Establishing baseline network statistics...{Style.RESET_ALL}")
        
        samples = []
        for i in range(5):
            print(f"Collecting sample {i+1}/5...")
            stats = self.get_network_statistics()
            samples.append(stats)
            if i < 4:  # Don't sleep after last sample
                time.sleep(2)
        
        # Calculate averages
        self.baseline_stats = {
            'timestamp': dt.now().isoformat(),
            'avg_connections': {},
            'avg_system_load': {}
        }
        
        # Average connection counts
        if samples:
            total_connections = defaultdict(int)
            for sample in samples:
                for conn_type, count in sample.get('connections', {}).items():
                    total_connections[conn_type] += count
            
            for conn_type, total in total_connections.items():
                self.baseline_stats['avg_connections'][conn_type] = total / len(samples)
        
        self.baseline_established = True
        print(f"{Fore.GREEN}Baseline established successfully{Style.RESET_ALL}")
        
    def main_menu(self):
        """Main menu interface"""
        while True:
            self.clear_screen()
            self.print_banner()
            
            menu_options = f"""
{Fore.GREEN}1.{Style.RESET_ALL} Single Network Analysis
{Fore.GREEN}2.{Style.RESET_ALL} Continuous Monitoring
{Fore.GREEN}3.{Style.RESET_ALL} View Current Statistics
{Fore.GREEN}4.{Style.RESET_ALL} View Suspicious Activity
{Fore.GREEN}5.{Style.RESET_ALL} Establish Baseline
{Fore.GREEN}6.{Style.RESET_ALL} Configure Thresholds
{Fore.GREEN}7.{Style.RESET_ALL} Save Report
{Fore.GREEN}8.{Style.RESET_ALL} Clear Activity Log
{Fore.GREEN}0.{Style.RESET_ALL} Exit
"""
            print(menu_options)
            
            try:
                choice = input(f"{Fore.CYAN}Select option: {Style.RESET_ALL}")
                
                if choice == '1':
                    print(f"\n{Fore.YELLOW}Performing network flood analysis...{Style.RESET_ALL}")
                    
                    # Take two measurements to calculate rates
                    stats1 = self.get_network_statistics()
                    time.sleep(2)
                    stats2 = self.get_network_statistics()
                    packet_stats = self.get_packet_statistics()
                    
                    rates = self.calculate_traffic_rates(stats2, stats1)
                    
                    suspicious = self.analyze_flood_patterns(stats2, rates)
                    syn_floods = self.detect_syn_flood(packet_stats)
                    suspicious.extend(syn_floods)
                    
                    self.suspicious_activity.extend(suspicious)
                    
                    self.display_network_stats(stats2, rates)
                    
                    if suspicious:
                        print(f"\n{Fore.RED}! {len(suspicious)} suspicious flood activities detected!{Style.RESET_ALL}")
                    else:
                        print(f"\n{Fore.GREEN}✓ No suspicious flood activity detected{Style.RESET_ALL}")
                        
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '2':
                    interval = input(f"{Fore.CYAN}Enter monitoring interval in seconds (default 5): {Style.RESET_ALL}")
                    try:
                        interval = int(interval) if interval else 5
                    except ValueError:
                        interval = 5
                    self.continuous_monitoring(interval)
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '3':
                    stats = self.get_network_statistics()
                    self.display_network_stats(stats)
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '4':
                    self.display_suspicious_activity()
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '5':
                    self.establish_baseline()
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '6':
                    self.configure_thresholds()
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '7':
                    filename = input(f"{Fore.CYAN}Enter filename (press Enter for auto-generated): {Style.RESET_ALL}")
                    self.save_report(filename if filename else None)
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '8':
                    self.suspicious_activity.clear()
                    print(f"{Fore.GREEN}Activity log cleared{Style.RESET_ALL}")
                    input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                    
                elif choice == '0':
                    print(f"{Fore.GREEN}Goodbye!{Style.RESET_ALL}")
                    sys.exit(0)
                    
                else:
                    print(f"{Fore.RED}Invalid option{Style.RESET_ALL}")
                    time.sleep(1)
                    
            except KeyboardInterrupt:
                print(f"\n{Fore.YELLOW}Exiting...{Style.RESET_ALL}")
                sys.exit(0)
            except Exception as e:
                print(f"{Fore.RED}Error: {e}{Style.RESET_ALL}")
                input(f"\n{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")

