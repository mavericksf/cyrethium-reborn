def main():
    """Main entry point for NetSecDragon Wireless Toolkit"""
    print(f"{Fore.CYAN}Initializing NetSecDragon Wireless Toolkit...{Style.RESET_ALL}")
    time.sleep(0.5)
    
    toolkit = NetSecDragonToolkit()
    toolkit.main_menu()

if __name__ == "__main__":
    main()