    def check_privileges(self):
        """Check if running with root/admin privileges"""
        if os.name == 'posix':
            try:
                return os.geteuid() == 0
            except AttributeError:
                return False
        return True
        
    def main_menu(self):
        """Main menu interface"""
        while True:
            self.clear_screen()
            self.print_main_banner()
            
            if not self.check_privileges():
                print(f"{Fore.YELLOW}⚠  Warning: Not running as root. Some modules may require elevated privileges.{Style.RESET_ALL}\n")
            
            print(f"\n{Fore.CYAN}════════════════════ SECURITY MODULES ════════════════════{Style.RESET_ALL}\n")
            print(f"  {Fore.CYAN}[1]{Style.RESET_ALL} {Fore.YELLOW}NetSecDragon ANTI-FLOOD{Style.RESET_ALL}")
            print(f"      DoS & Flood Attack Detection\n")
            
            print(f"  {Fore.CYAN}[2]{Style.RESET_ALL} {Fore.YELLOW}NetSecDragon ANTI-SCAN{Style.RESET_ALL}")
            print(f"      Port Scan Detection & Monitoring\n")
            
            print(f"  {Fore.CYAN}[3]{Style.RESET_ALL} {Fore.YELLOW}NetSecDragon ANTI-MITM{Style.RESET_ALL}")
            print(f"      ARP Analysis & MITM Detection\n")
            
            print(f"  {Fore.CYAN}[4]{Style.RESET_ALL} {Fore.YELLOW}NetSecDragon ANTI-DEAUTH{Style.RESET_ALL}")
            print(f"      WiFi Deauth Detection & Analysis\n")
            
            print(f"  {Fore.RED}[0]{Style.RESET_ALL} {Fore.YELLOW}Exit Toolkit{Style.RESET_ALL}\n")
            print(f"{Fore.CYAN}══════════════════════════════════════════════════════════{Style.RESET_ALL}\n")
            
            try:
                choice = input(f"{Fore.CYAN}NetSecDragon ➜ {Style.RESET_ALL}").strip()
                
                if choice == '1':
                    if not self.check_privileges():
                        print(f"\n{Fore.RED}This module requires root privileges.{Style.RESET_ALL}")
                        input(f"{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                        continue
                    analyzer = FloodAnalyzer()
                    analyzer.main_menu()
                    
                elif choice == '2':
                    if not self.check_privileges():
                        print(f"\n{Fore.RED}This module requires root privileges.{Style.RESET_ALL}")
                        input(f"{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                        continue
                    analyzer = PortScanAnalyzer()
                    analyzer.main_menu()
                    
                elif choice == '3':
                    if not self.check_privileges():
                        print(f"\n{Fore.RED}This module requires root privileges.{Style.RESET_ALL}")
                        input(f"{Fore.YELLOW}Press Enter to continue...{Style.RESET_ALL}")
                        continue
                    analyzer = ARPAnalyzer()
