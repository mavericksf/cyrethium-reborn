    print(warning_text)
    
    while True:
        response = input("Do you understand and accept these terms? (y/N): ").strip().lower()
        
        if response in ['n', 'no', '']:
            print("\n[INFO] Tool usage cancelled. Stay safe!")
            sys.exit(0)
        elif response in ['y', 'yes']:
            print("\n[INFO] Ethical terms accepted. Starting tool...")
