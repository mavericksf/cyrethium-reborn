class ChaosecTool:
    def __init__(self):
        self.threads = []
        self.intensity = 1.0
        self.pattern = "browsing"
        self.tor_mode = False
        self.stats = {"dns": 0, "http": 0, "tcp": 0, "udp": 0}
        self.config_file = Path.home() / ".config" / "chaosec" / "config.json"
        self.custom_domains = []
        self.start_time = None
        self.total_requests = 0
        self.max_duration = MAX_RUNTIME_SECONDS
        self.timer_thread = None
        self.last_warning_time = 0
        
        self.config_file.parent.mkdir(parents=True, exist_ok=True)
        
        self.load_config()
    
    def load_config(self):
        try:
            if self.config_file.exists():
                with open(self.config_file, 'r') as f:
                    config = json.load(f)
                    self.custom_domains = config.get('custom_domains', [])
                    print(f"[INFO] Loaded {len(self.custom_domains)} custom domains")
        except Exception as e:
            print(f"[WARNING] Failed to load config: {e}")
    
    def save_config(self):
        try:
            config = {
                'custom_domains': self.custom_domains,
                'last_updated': datetime.now().isoformat()
            }
            with open(self.config_file, 'w') as f:
                json.dump(config, f, indent=2)
            print(f"[INFO] Configuration saved")
        except Exception as e:
            print(f"[ERROR] Failed to save config: {e}")
    
    
    def add_custom_domain(self, domain: str):
        if domain not in self.custom_domains:
            self.custom_domains.append(domain)
            self.save_config()
            print(f"[INFO] Added custom domain: {domain}")
    
    def show_statistics(self):
        if self.start_time:
            runtime = datetime.now() - self.start_time
            print(f"\n{'='*50}")
            print(f"CHAOSEC STATISTICS")
            print(f"{'='*50}")
            print(f"Runtime: {runtime}")
            print(f"Total requests: {self.total_requests}")
            print(f"Requests per minute: {self.total_requests / (runtime.total_seconds() / 60):.1f}")
            print(f"\nTraffic breakdown:")
            for traffic_type, count in self.stats.items():
                percentage = (count / max(self.total_requests, 1)) * 100
                print(f"  {traffic_type.upper()}: {count} ({percentage:.1f}%)")
            print(f"\nPattern: {self.pattern} ({TRAFFIC_PATTERNS[self.pattern]['description']})")
            print(f"Intensity: {self.intensity}x")
            print(f"Tor mode: {'Enabled' if self.tor_mode else 'Disabled'}")
            print(f"{'='*50}")
    
    def list_patterns(self):
        print(f"\n{'='*60}")
        print(f"AVAILABLE TRAFFIC PATTERNS")
        print(f"{'='*60}")
        for pattern, config in TRAFFIC_PATTERNS.items():
            print(f"\n{pattern.upper()}:")
            print(f"  Description: {config['description']}")
            print(f"  HTTP ratio: {config['http_ratio']}")
            print(f"  DNS ratio: {config['dns_ratio']}")
            print(f"  TCP ratio: {config['tcp_ratio']}")
            print(f"  UDP ratio: {config['udp_ratio']}")
            print(f"  Interval: {config['interval_min']}-{config['interval_max']}s")
        print(f"{'='*60}")
        
    def start(self, args):
        self.intensity = args.intensity
        self.pattern = args.pattern
        self.tor_mode = args.tor_mode
        self.start_time = datetime.now()
        
        if hasattr(args, 'list_patterns') and args.list_patterns:
            self.list_patterns()
            return
            
            
        if hasattr(args, 'show_stats') and args.show_stats:
            self.show_statistics()
            return
        
        self._show_banner(args)
        
        if args.dns_noise:
            thread = threading.Thread(target=self.generate_dns_noise)
            thread.daemon = True
            thread.start()
            self.threads.append(thread)
            print(f"[INFO] DNS noise generator active")
            
        if args.http_flood:
            thread = threading.Thread(target=self.generate_http_noise)
            thread.daemon = True
            thread.start()
            self.threads.append(thread)
            print(f"[INFO] HTTP traffic generator active")
            
        if args.tcp_noise:
            thread = threading.Thread(target=self.generate_tcp_noise)
            thread.daemon = True
            thread.start()
            self.threads.append(thread)
            print(f"[INFO] TCP connection noise active")
            
        if args.udp_noise:
            thread = threading.Thread(target=self.generate_udp_noise)
            thread.daemon = True
            thread.start()
            self.threads.append(thread)
            print(f"[INFO] UDP packet noise active")
            
            
        if args.verbose:
            thread = threading.Thread(target=self._print_stats)
            thread.daemon = True
            thread.start()
            self.threads.append(thread)
        
        active_generators = [
            args.dns_noise, args.http_flood, args.tcp_noise, args.udp_noise
        ]
        
        if not any(active_generators):
            print(f"[WARNING] No noise generators selected. Use --help for options.")
            return
            
        self.start_duration_timer()
        
        try:
            while running:
                elapsed = (datetime.now() - self.start_time).total_seconds()
                remaining = self.max_duration - elapsed
                
                if remaining <= 60 and time.time() - self.last_warning_time >= 30:
                    print(f"[WARNING] Time remaining: {format_time_remaining(remaining)}")
                    self.last_warning_time = time.time()
                elif remaining <= 120 and time.time() - self.last_warning_time >= 60:
                    print(f"[WARNING] Time remaining: {format_time_remaining(remaining)}")
                    self.last_warning_time = time.time()
                
                time.sleep(1)
        except KeyboardInterrupt:
            print("\n[INFO] Stopped by user.")
            self.stop()
    
    def _show_banner(self, args):
        banner = """
        ██████╗██╗  ██╗ █████╗  ██████╗ ███████╗███████╗ ██████╗
       ██╔════╝██║  ██║██╔══██╗██╔═══██╗██╔════╝██╔════╝██╔════╝
       ██║     ███████║███████║██║   ██║███████╗█████╗  ██║     
       ██║     ██╔══██║██╔══██║██║   ██║╚════██║██╔══╝  ██║     
       ╚██████╗██║  ██║██║  ██║╚██████╔╝███████║███████╗╚██████╗
        ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚══════╝ ╚═════╝
        Traffic Obfuscation Tool for Cyrethium
        """
        print(banner)
        
        print(f"[INFO] Starting with pattern: {self.pattern}, intensity: {self.intensity}x")
        active_modules = []
        if args.dns_noise: active_modules.append("DNS")
        if args.http_flood: active_modules.append("HTTP")
        if args.tcp_noise: active_modules.append("TCP")
        if args.udp_noise: active_modules.append("UDP")
        
        print(f"[INFO] Active modules: {' '.join(active_modules)}")
        
        if self.tor_mode:
            print(f"[INFO] Tor mode: Active - Traffic will be optimized for Tor network")
        
    def _print_stats(self):
        while running:
            time.sleep(10)
            print(f"[STATS] Traffic (last 10s): DNS:{self.stats['dns']} HTTP:{self.stats['http']} TCP:{self.stats['tcp']} UDP:{self.stats['udp']}")
            self.stats = {"dns": 0, "http": 0, "tcp": 0, "udp": 0}
            
    def start_duration_timer(self):
        def duration_handler():
            global running
            time.sleep(self.max_duration)
            if running:
                print(f"\n[WARNING] MAXIMUM TIME REACHED! (5 minutes)")
                print(f"[INFO] Tool automatically stopping for security reasons...")
                running = False
                
        self.timer_thread = threading.Thread(target=duration_handler)
        self.timer_thread.daemon = True
        self.timer_thread.start()
    
    def stop(self):
        global running
        running = False
        print(f"[INFO] Stopping all traffic generators...")
        
        if self.start_time:
            elapsed = (datetime.now() - self.start_time).total_seconds()
            print(f"[INFO] Total runtime: {format_time_remaining(elapsed)}")
            print(f"[INFO] Total requests: {self.total_requests}")
        
        for thread in self.threads:
            thread.join(timeout=1.0)
        print(f"[INFO] Chaosec stopped successfully. Stay safe!")
        
