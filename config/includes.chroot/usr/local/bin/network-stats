#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

clear_screen() {
    clear
}

print_section() {
    echo -e "${YELLOW}━━━ $1 ━━━${NC}"
}

check_root() {
    if [[ $EUID -eq 0 ]]; then
        echo -e "${GREEN}✓ Running with root privileges${NC}"
        return 0
    else
        echo -e "${YELLOW}⚠ Some features require root privileges${NC}"
        return 1
    fi
}

show_interfaces() {
    print_section "Network Interfaces"
    
    if command_exists ip; then
        echo -e "${CYAN}Active Network Interfaces:${NC}"
        ip -br addr show | while read -r interface flags addr; do
            if [[ "$flags" == *"UP"* ]]; then
                if [[ "$interface" == *"tun"* || "$interface" == *"tap"* || "$interface" == *"wg"* ]]; then
                    echo -e "  ${GREEN}$interface${NC}: $addr ${YELLOW}(VPN)${NC}"
                else
                    echo -e "  ${CYAN}$interface${NC}: $addr"
                fi
            fi
        done
    else
        echo -e "${RED}ip command not available. Install iproute2.${NC}"
        if command_exists ifconfig; then
            echo -e "${CYAN}Using ifconfig:${NC}"
            ifconfig | grep -A1 '^[a-zA-Z]' | grep -E '^[a-zA-Z]|inet '
        fi
    fi
}

show_routing() {
    print_section "Routing Information"
    
    echo -e "${CYAN}Default Routes:${NC}"
    if command_exists ip; then
        ip route show default | while read -r line; do
            gateway=$(echo "$line" | awk '{print $3}')
            interface=$(echo "$line" | awk '{print $5}')
            echo -e "  Gateway: ${GREEN}$gateway${NC} via ${BLUE}$interface${NC}"
        done
        
        echo
        echo -e "${CYAN}Route Table:${NC}"
        ip route show | head -20
    else
        echo -e "${RED}ip command not available${NC}"
        if command_exists route; then
            echo -e "${CYAN}Using route command:${NC}"
            route -n | head -10
        fi
    fi
}

show_dns() {
    print_section "DNS Configuration"
    
    if [[ -f /etc/resolv.conf ]]; then
        echo -e "${CYAN}/etc/resolv.conf:${NC}"
        while read -r line; do
            if [[ "$line" =~ ^nameserver ]]; then
                dns_server=$(echo "$line" | awk '{print $2}')
                if [[ "$dns_server" == "127.0.0.1" || "$dns_server" == "::1" ]]; then
                    echo -e "  ${GREEN}$line${NC} (Local resolver)"
                elif [[ "$dns_server" =~ ^192\.168\.|^10\.|^172\. ]]; then
                    echo -e "  ${YELLOW}$line${NC} (Private network)"
                else
                    echo -e "  ${CYAN}$line${NC}"
                fi
            else
                echo -e "  $line"
            fi
        done < /etc/resolv.conf
    else
        echo -e "${RED}/etc/resolv.conf not found${NC}"
    fi
}

show_connections() {
    print_section "Active Network Connections"
    
    if command_exists ss; then
        echo -e "${CYAN}Listening Services:${NC}"
        ss -tuln | awk 'NR>1 {print $1, $5}' | sort | while read -r proto addr; do
            port=$(echo "$addr" | sed 's/.*://')
            if [[ "$port" =~ ^[0-9]+$ ]]; then
                case "$port" in
                    22) echo -e "  ${GREEN}$proto $addr${NC} (SSH)" ;;
                    80) echo -e "  ${GREEN}$proto $addr${NC} (HTTP)" ;;
                    443) echo -e "  ${GREEN}$proto $addr${NC} (HTTPS)" ;;
                    53) echo -e "  ${GREEN}$proto $addr${NC} (DNS)" ;;
                    *) echo -e "  ${CYAN}$proto $addr${NC}" ;;
                esac
            fi
        done | head -20
    elif command_exists netstat; then
        echo -e "${CYAN}Using netstat:${NC}"
        netstat -tuln | awk 'NR>2 {print $1, $4}' | head -20
    else
        echo -e "${RED}Neither ss nor netstat available${NC}"
    fi
}

ping_test() {
    print_section "Connectivity Test"
    
    echo -e "${CYAN}Testing connectivity:${NC}"
    
    echo -n "  Ping test (1.1.1.1)... "
    if timeout 2 ping -c 1 -W 1 "1.1.1.1" &>/dev/null; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
    fi
    
    echo -n "  HTTP test (duckduckgo.com)... "
    if command_exists curl; then
        if timeout 3 curl -s -I "https://duckduckgo.com" &>/dev/null; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
    elif command_exists wget; then
        if timeout 3 wget --spider --quiet "https://duckduckgo.com" &>/dev/null; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ curl/wget not available${NC}"
    fi
}

fix_network() {
    print_section "Network & IPTables Fixer"
    
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}✗ This function requires root privileges!${NC}"
        return 1
    fi
    
    echo -e "${RED}WARNING:${NC} This will ${RED}RESET ALL${NC} iptables rules and network settings!"
    echo -e "${YELLOW}1.${NC} All iptables rules will be flushed"
    echo -e "${YELLOW}2.${NC} Banned IPs will be unblocked"
    echo -e "${YELLOW}3.${NC} All firewall settings will be reset"
    echo -e "${YELLOW}4.${NC} Network interfaces will be reset"
    echo
    
    echo -e "${CYAN}Checking if traffic is routed through Tor...${NC}"
    if command_exists curl; then
        TOR_CHECK=$(curl -s --max-time 5 https://check.torproject.org/ 2>/dev/null | grep -i "Congratulations")
        if [[ -n "$TOR_CHECK" ]]; then
            echo -e "${RED}✗ Tor routing detected!${NC}"
            echo -e "${YELLOW}STOP Tor routing before cleaning to avoid IP leaks!${NC}"
            echo
            read -p "Type YES to continue anyway: " tor_confirm
            if [[ "$tor_confirm" != "YES" ]]; then
                echo -e "${GREEN}Operation cancelled.${NC}"
                return 1
            fi
        else
            echo -e "${GREEN}✓ No Tor routing detected. Safe to continue.${NC}"
        fi
    fi
    
    echo
    read -p "Type YES to confirm cleanup: " confirm
    if [[ "$confirm" != "YES" ]]; then
        echo -e "${GREEN}Operation cancelled.${NC}"
        return 1
    fi
    
    echo
    echo -e "${YELLOW}Starting network and iptables cleanup...${NC}"
    sleep 1
    
    echo -e "${CYAN}Flushing iptables rules...${NC}"
    iptables -F 2>/dev/null && echo -e "  ${GREEN}✓${NC} Filter table flushed"
    iptables -X 2>/dev/null && echo -e "  ${GREEN}✓${NC} User-defined chains deleted"
    iptables -t nat -F 2>/dev/null && echo -e "  ${GREEN}✓${NC} NAT table flushed"
    iptables -t nat -X 2>/dev/null
    iptables -t mangle -F 2>/dev/null && echo -e "  ${GREEN}✓${NC} Mangle table flushed"
    iptables -t mangle -X 2>/dev/null
    iptables -t raw -F 2>/dev/null && echo -e "  ${GREEN}✓${NC} Raw table flushed"
    iptables -t raw -X 2>/dev/null
    
    echo -e "${CYAN}Setting default policies to ACCEPT...${NC}"
    iptables -P INPUT ACCEPT 2>/dev/null && echo -e "  ${GREEN}✓${NC} INPUT = ACCEPT"
    iptables -P FORWARD ACCEPT 2>/dev/null && echo -e "  ${GREEN}✓${NC} FORWARD = ACCEPT"
    iptables -P OUTPUT ACCEPT 2>/dev/null && echo -e "  ${GREEN}✓${NC} OUTPUT = ACCEPT"
    
    echo -e "${CYAN}Resetting network interfaces...${NC}"
    for iface in $(ls /sys/class/net 2>/dev/null | grep -v lo); do
        ip link set $iface down 2>/dev/null
        ip addr flush dev $iface 2>/dev/null
        ip link set $iface up 2>/dev/null
        echo -e "  ${GREEN}✓${NC} Interface $iface reset"
    done
    
    echo -e "${CYAN}Flushing routing table...${NC}"
    ip route flush table main 2>/dev/null && echo -e "  ${GREEN}✓${NC} Main routing table flushed"
    
    echo
    echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  Cleanup Complete! Network Reset.     ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
}

main_menu() {
    while true; do
        clear_screen
        
        echo -e "${YELLOW}System: ${CYAN}$(hostname)${NC} | ${YELLOW}Kernel: ${CYAN}$(uname -r)${NC}"
        check_root
        echo
        
        echo -e "${YELLOW}Network Statistics Options:${NC}"
        echo
        echo -e "${GREEN}1.${NC} Show network interfaces"
        echo -e "${GREEN}2.${NC} Show routing information"
        echo -e "${GREEN}3.${NC} Show DNS configuration"
        echo -e "${GREEN}4.${NC} Show active connections"
        echo -e "${GREEN}5.${NC} Run connectivity test"
        echo -e "${GREEN}6.${NC} Show all network info"
        echo -e "${RED}7.${NC} Fix network & reset iptables ${YELLOW}(Requires root)${NC}"
        echo -e "${GREEN}0.${NC} Exit"
        echo
        
        read -p "Select option: " choice
        
        case $choice in
            1)
                echo
                show_interfaces
                echo
                read -p "Press Enter to continue..."
                ;;
            2)
                echo
                show_routing
                echo
                read -p "Press Enter to continue..."
                ;;
            3)
                echo
                show_dns
                echo
                read -p "Press Enter to continue..."
                ;;
            4)
                echo
                show_connections
                echo
                read -p "Press Enter to continue..."
                ;;
            5)
                echo
                ping_test
                echo
                read -p "Press Enter to continue..."
                ;;
            6)
                echo
                show_interfaces
                echo
                show_routing
                echo
                show_dns
                echo
                show_connections
                echo
                ping_test
                echo
                read -p "Press Enter to continue..."
                ;;
            7)
                echo
                fix_network
                echo
                read -p "Press Enter to continue..."
                ;;
            0)
                echo -e "${GREEN}Goodbye!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                sleep 1
                ;;
        esac
    done
}

main() {
    required_tools=("ip" "ping")
    missing_tools=()
    
    for tool in "${required_tools[@]}"; do
        if ! command_exists "$tool"; then
            missing_tools+=("$tool")
        fi
    done
    
    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        echo -e "${YELLOW}Warning: Missing tools: ${missing_tools[*]}${NC}"
        echo -e "${YELLOW}Install with: apt install iproute2 iputils-ping${NC}"
        echo -e "${YELLOW}Some features may be limited.${NC}"
        echo
    fi
    
    main_menu
}

main "$@"